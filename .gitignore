# Generated + processed data. All of it is reproducible from
# `make pipeline` with a fixed seed, so none of it belongs in git --
# data/published alone is ~83MB.
data/raw/*
data/clean/*
data/embedded/
data/published/
data/eval/
!data/raw/.gitkeep
!data/clean/.gitkeep

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
